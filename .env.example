# Copy to .env and fill in real values. Never commit .env to git.
# All values below are dummy placeholders.

# --- REQUIRED: shared secret for the API ---
# Every /api/* endpoint requires the header: X-API-Key: <this value>
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-long-random-secret

# --- LLM provider keys (use real keys in production) ---
# Keys can also be supplied per-request via X-OpenAI-Key / X-Anthropic-Key /
# X-Gemini-Key / X-GLM-Key headers, or stored via POST /api/settings/keys.
OPENAI_API_KEY=sk-dummy-placeholder
ANTHROPIC_API_KEY=sk-ant-dummy-placeholder
GEMINI_API_KEY=dummy-placeholder
ZHIPUAI_API_KEY=dummy-placeholder

# --- Database ---
# Default is local SQLite. For Postgres: postgresql+asyncpg://user:pass@host/db
# (add `asyncpg` to backend/requirements.txt if you switch to Postgres)
DATABASE_URL=sqlite+aiosqlite:///./social.db

# --- Ollama (local models) ---
# Base URL used when model_id starts with "ollama"
OLLAMA_BASE_URL=http://localhost:11434

# --- CORS ---
# Comma-separated list of allowed browser origins. Leave empty in pure-API
# deployments. Example for a deployed frontend:
# CORS_ORIGINS=https://your-frontend.onrender.com,https://app.yourdomain.com
CORS_ORIGINS=

# --- Port ---
# Local dev port for uvicorn. Render sets this automatically.
PORT=8008

# --- Frontend (NEXT_PUBLIC_* vars are read by the Next.js app at build time) ---
# URL of the backend API the browser should call
NEXT_PUBLIC_API_URL=http://localhost:8008
# Same value as API_KEY above — sent by the UI as the X-API-Key header
NEXT_PUBLIC_API_KEY=changeme-generate-a-long-random-secret
